# Configuration de la base de données MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=controle_depense
DB_USER=root
DB_PASSWORD=changez_ce_mot_de_passe

# Clés de sécurité cryptographiques
# Clé secrète de signature et dérivation des sessions (min 32 octets hex)
SESSION_SECRET=votre_cle_secrete_session_64_caracteres_hex_ici

# Clé de chiffrement AES-256-GCM pour CNI et téléphones (exactement 32 octets = 64 caractères hex)
FIELD_ENCRYPTION_KEY=votre_cle_aes256_gcm_64_caracteres_hex_ici

# Paramètres généraux
PORT=3000
NODE_ENV=development
